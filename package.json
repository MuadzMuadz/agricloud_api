{
  "name": "agricloud_api",
  "version": "0.1.0",
  "description": "AgriCloud backend REST API — Hono + Bun + TypeScript (migrasi dari Laravel)",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "parity": "bun run scripts/parity-check.ts",
    "backfill:images": "bun run scripts/backfill-image-urls.ts",
    "db:introspect": "drizzle-kit introspect",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^9.15.0",
    "hono": "^4.6.14",
    "jose": "^6.2.3",
    "nodemailer": "^6.9.16",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.1.14",
    "@types/nodemailer": "^6.4.17",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
