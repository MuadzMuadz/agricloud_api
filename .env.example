# ===================================================================
# agricloud_api — template ENV. Salin ke .env (dev) atau .env.production.
# Diadaptasi dari Laravel Agricloud_v2. Pemetaan lengkap:
# vault/Plans/Backend-Migration-JS-Env-Mapping.md
# ===================================================================

# --- App ---
APP_ENV=local                       # local | production
PORT=8005                           # dev (Bun). Diabaikan di serverless.
APP_URL=http://localhost:8005
APP_FRONTEND_URL=http://localhost:8006
# Allowlist origin exact (koma utk banyak). localhost:8006/3000 sudah default.
# Produksi: isi domain Vercel final, mis. https://agricloud.vercel.app
CORS_ALLOWED_ORIGINS=https://<app>.vercel.app
# Pola regex origin rotatif (koma utk banyak). Default sudah cover semua *.vercel.app
# termasuk preview deployment. Kosongkan hanya bila ingin override default.
CORS_ALLOWED_ORIGIN_PATTERNS=^https://([a-z0-9-]+\.)*vercel\.app$

# --- Database ---
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5434/agricloud_v2
# Serverless + pooler Supabase: pakai URL pooler :6543 dan set DB_PREPARE=false.
DB_PREPARE=true                     # false WAJIB untuk pooler transaction mode

# --- Auth (JWT) ---
JWT_SECRET=<generate-32+char-random>
JWT_ISSUER=agricloud
AGRICLOUD_TOKEN_TTL_DEFAULT=1440    # menit (1 hari)
AGRICLOUD_TOKEN_TTL_REMEMBER=43200  # menit (30 hari)

# --- Storage ---
STORAGE_DRIVER=local                # local (dev) | supabase (prod)
SUPABASE_URL=<https://xxx.supabase.co>
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET=public

# --- Domain thresholds ---
AGRICLOUD_LOW_STOCK_THRESHOLD=10
AGRICLOUD_HARVEST_LOOKAHEAD_DAYS=7
AGRICLOUD_URGENT_WINDOW_DAYS=2

# --- Google OAuth (sama dengan Laravel) ---
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<secret>

# --- Mail / Brevo (sama dengan Laravel) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<secret>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=muadz848@gmail.com
MAIL_FROM_NAME=AgriCloud

# --- Weather (Open-Meteo) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_CACHE_TTL=1800
WEATHER_DEFAULT_LAT=-6.7063
WEATHER_DEFAULT_LON=108.5571
WEATHER_DEFAULT_DISTRICT=Kejaksan, Cirebon
